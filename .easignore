# EAS upload ignore — must live at the GIT REPO ROOT (Expo archives from here, not mobile/).
# https://expo.fyi/eas-build-archive
# Do not use trailing slashes on directory patterns (eas-cli copy bug with "dir/").

# --- Dependencies & caches (EAS runs pnpm install on the server) ---
node_modules
.pnpm-store

# --- Native project dirs (EAS prebuild generates these; local copies are huge) ---
mobile/ios
mobile/android

# --- Secrets & local tooling ---
.env
.env.*
!.env.example
.cursor
.git
.cache
.local
.DS_Store
Thumbs.db

# --- Build / IDE artifacts ---
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared
web-build
coverage
**/.next
.vercel
*.tsbuildinfo
npm-debug.log
yarn-error.log
testem.log

# --- Not needed to build the mobile app ---
artifacts
web-admin
lib/db
lib/api-zod
lib/api-spec
scripts

