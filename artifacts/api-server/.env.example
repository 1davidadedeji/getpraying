# =============================================================================
# API server — put ALL backend secrets here (this file wins over repo-root .env)
# Copy to artifacts/api-server/.env  |  never commit .env
# =============================================================================

HOST=0.0.0.0
PORT=3001

DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Optional: OpenAI (simulated activity / compose helpers)
OPENAI_API_KEY=

# SendGrid (verification / password-reset email). If unset, OTP is logged to the API console.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=support@getpraying.com

# Public API URL used in share / App Link payloads (not read by the Expo app).
EXPO_PUBLIC_API_BASE_URL=https://api.getpraying.com

# Expo push (authenticated). Either name works.
EXPO_ACCESS_TOKEN=
# EXPO_PUSH_ACCESS_TOKEN=

# RevenueCat webhook Authorization: Bearer <this>
REVENUECAT_WEBHOOK_SECRET=

# Share links / Universal Links
SHARE_WEB_ORIGIN=https://share.getpraying.com
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.getpraying.app
ANDROID_PACKAGE_NAME=com.getpraying.app
ANDROID_CERT_FINGERPRINT=
IOS_STORE_URL=
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.getpraying.app
