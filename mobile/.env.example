# =============================================================================
# GetPraying — Expo / mobile (repo root mobile/)
# Copy to .env. EXPO_PUBLIC_* vars are inlined at build time — rebuild after changes.
# =============================================================================

# Production API (default in code matches this). Override in .env only when pointing at a different backend.
EXPO_PUBLIC_API_BASE_URL=https://api.getpraying.com

# RevenueCat public SDK keys (native IAP). Empty = SDK skipped; paywall won’t match prod.
# Android APK / Play testing: set GOOGLE key. iOS: set APPLE key.
EXPO_PUBLIC_RC_APPLE_KEY=
EXPO_PUBLIC_RC_GOOGLE_KEY=
