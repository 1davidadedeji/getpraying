# =============================================================================
# GetPraying — Expo / mobile (repo root mobile/)
# Copy to .env. EXPO_PUBLIC_* vars are inlined at build time — rebuild after changes.
# =============================================================================

# Production API (default in code matches this). Override in .env only when pointing at a different backend.
EXPO_PUBLIC_API_BASE_URL=https://api.getpraying.com

# HTTPS host for shared prayer links + Universal/App Links (share.getpraying.com).
EXPO_PUBLIC_SHARE_WEB_ORIGIN=https://share.getpraying.com

# Web-admin CMS for moderators/admins (opens in browser from settings + staff push taps).
EXPO_PUBLIC_WEB_ADMIN_ORIGIN=https://admin.getpraying.com

# RevenueCat public SDK keys (native IAP). Empty = SDK skipped; paywall won’t match prod.
# Android APK / Play testing: set GOOGLE key. iOS: set APPLE key.
# Aliases EXPO_PUBLIC_RC_IOS_KEY / EXPO_PUBLIC_RC_ANDROID_KEY also work.
EXPO_PUBLIC_RC_APPLE_KEY=
EXPO_PUBLIC_RC_GOOGLE_KEY=

# Optional: RevenueCat offering id if not named "default" (must match dashboard).
# EXPO_PUBLIC_RC_OFFERING_ID=default

# Optional: direct store product id fallback if offerings are empty (Play Console / App Store Connect id).
# EXPO_PUBLIC_RC_GOOGLE_PRODUCT_ID=getpraying_monthly_699
# EXPO_PUBLIC_RC_APPLE_PRODUCT_ID=
