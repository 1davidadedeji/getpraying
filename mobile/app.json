{
  "expo": {
    "name": "Get Praying",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "getpraying",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon-bg.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F6F0",
      "imageWidth": 280
    },
    "ios": {
      "supportsTablet": true,
      "associatedDomains": ["applinks:share.getpraying.com"],
      "infoPlist": {
        "CFBundleDisplayName": "Get Praying",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.getpraying.app"
    },
    "android": {
      "package": "com.getpraying.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F9F6F0"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "share.getpraying.com",
              "pathPrefix": "/post"
            },
            {
              "scheme": "https",
              "host": "share.getpraying.com",
              "pathPrefix": "/official"
            },
            {
              "scheme": "https",
              "host": "share.getpraying.com",
              "pathPrefix": "/path"
            },
            {
              "scheme": "https",
              "host": "share.getpraying.com",
              "pathPrefix": "/user"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-bg.png",
          "resizeMode": "contain",
          "backgroundColor": "#F9F6F0",
          "imageWidth": 280
        }
      ],
      [
        "expo-router",
        {
          "origin": "https://share.getpraying.com"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResources": true,
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keep class expo.modules.image.** { *; }\n-keep class com.github.bumptech.glide.** { *; }\n-keep class com.bumptech.glide.** { *; }"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Get Praying to access your media library to attach audio prayers.",
          "savePhotosPermission": "Allow Get Praying to save media.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1A1F36"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "autolinkingModuleResolution": true
    },
    "extra": {
      "eas": {
        "projectId": "b11d202d-876e-4839-b3d5-0051e73ad11b"
      }
    },
    "owner": "timelesz_dave"
  }
}
