# =============================================================================
# GetPraying — optional repo-root .env
# The API now loads this file AND artifacts/api-server/.env (api-server wins).
# Prefer keeping production secrets only in artifacts/api-server/.env so they
# cannot drift. Do not put EXPO_PUBLIC_RC_* or mobile keys here.
# =============================================================================


# --- Required for API + database library ---
# PostgreSQL connection string used by artifacts/api-server and lib/db tooling.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# --- Optional: OpenAI (compose / AI category suggestion on API) ---
OPENAI_API_KEY=

# --- Optional: SendGrid (real verification emails) ---
# If unset, registration still works; OTP is typically logged to the API console.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- Optional: documented for convenience (mobile reads EXPO_PUBLIC_* at build time) ---
# The Expo app uses mobile/.env for EXPO_PUBLIC_* — set the same URL there
# for device/APK builds. Use a LAN IP or HTTPS host, not localhost, on a real phone.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# --- Optional ---
# NODE_ENV=production
# LOG_LEVEL=info

# --- Optional: share link domain (defaults to https://share.getpraying.com) ---
# SHARE_WEB_ORIGIN=https://share.getpraying.com
# IOS_STORE_URL=https://apps.apple.com/app/idXXXXXXXXX
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.getpraying.app

# --- Optional: Universal / App Links verification (share.getpraying.com) ---
# Served by the API share router (artifacts/api-server/src/routes/share.ts), NOT Vercel.
# Defaults include Play + debug SHA-256 certs; set ANDROID_CERT_FINGERPRINT to override/extend.
# 1. Proxy share.getpraying.com → API (see artifacts/api-server/deploy/nginx-share.conf)
# 2. Redeploy/restart the API after changing fingerprints (pm2 restart getpraying-api --update-env)
# APPLE_TEAM_ID=
# APPLE_BUNDLE_ID=com.getpraying.app
# ANDROID_PACKAGE_NAME=com.getpraying.app
# ANDROID_CERT_FINGERPRINT=82FE0A0CC8BC181674EC05A0B8B5070035F2C99862595BC3CBEC34883EC24D93,31:BC:7E:7D:CE:CB:D3:36:E8:BF:A8:83:AC:32:9A:9E:17:50:60:EB:44:1D:48:D1:56:17:13:BD:F8:2A:39:1C

# --- Expo push (API server → production app @timelesz_dave/get-praying) ---
# Create at https://expo.dev/accounts/timelesz_dave/projects/get-praying → Access tokens
# PM2 must load this (repo root .env or api-server cwd). Restart: pm2 restart getpraying-api --update-env
EXPO_ACCESS_TOKEN=

# --- Optional: RevenueCat webhook (POST /api/webhooks/revenuecat) ---
# Set the same secret in RevenueCat dashboard → Project → Integrations → Webhooks.
# REVENUECAT_WEBHOOK_SECRET=
